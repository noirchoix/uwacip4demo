PIPE4_ENVIRONMENT=development
PIPE4_LOG_LEVEL=INFO
PIPE4_API_PORT=8000
PIPE4_WEB_PORT=3000
PIPE4_GATEWAY_PORT=8080
PIPE4_DATABASE_URL=postgresql+asyncpg://pipe4:pipe4@postgres:5432/pipe4
PIPE4_REDIS_URL=redis://redis:6379/0
PIPE4_POLICY_PATH=/app/config/policies/pipe4-policy.v1.yaml
PIPE4_EVIDENCE_BACKEND=local
PIPE4_EVIDENCE_LOCAL_ROOT=/var/lib/pipe4/evidence
PIPE4_EVIDENCE_BUCKET=
PIPE4_EVIDENCE_ENDPOINT_URL=
PIPE4_EVIDENCE_ACCESS_KEY_ID=
PIPE4_EVIDENCE_SECRET_ACCESS_KEY=
PIPE4_JWT_ISSUER=
PIPE4_JWT_AUDIENCE=
PIPE4_JWT_JWKS_URL=
PIPE4_JWT_HS256_SECRET=dev-only-secret-change-me
PIPE4_INTERNAL_API_TOKEN=dev-internal-token-change-me
PIPE4_AI_GATEWAY_URL=
PIPE4_AI_GATEWAY_TOKEN=
PIPE4_ENABLE_DEV_FIXTURES=true
PIPE4_CORS_ALLOWED_ORIGINS=http://localhost:3000
PUBLIC_PIPE4_API_ORIGIN=http://api:8000
PIPE4_WEB_DEV_MODE=true

PIPE4_RATE_LIMIT_DEFAULT_PER_MINUTE=120
PIPE4_RATE_LIMIT_NEARBY_PER_MINUTE=60
PIPE4_RATE_LIMIT_WITNESS_PER_MINUTE=20
PIPE4_RATE_LIMIT_MUTATION_PER_MINUTE=60
